#!/bin/sh
# Rebuilds the section and recipe pages whenever index.html, CNAME or the build tools are committed,
# so they never fall behind.   Install once with:   cp tools/pre-commit .git/hooks/pre-commit
if git diff --cached --name-only | grep -qE '^(index\.html|CNAME|tools/build-pages\.sh|tools/recipes\.awk)$'; then
  bash tools/build-pages.sh >/dev/null || exit 1
  git add -A index.html robots.txt sitemap.xml recipes plan-your-week quizzes kitchen-sos air-fryer faq about privacy feedback
fi
